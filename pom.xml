pipeline {
    agent any

    tools {
        jdk 'JDK-17'      // name from Global Tool Configuration
        maven 'Maven-3.9' // name from Global Tool Configuration
    }

    stages {
        stage('Checkout') {
            steps {
                // If using Git SCM in job config, this can be just:
                checkout scm
                // Or explicitly:
                // git branch: 'main', url: 'https://github.com/youruser/your-repo.git'
            }
        }

        stage('Build') {
            steps {
                script {
                    bat 'mvn clean compile -B'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    bat 'mvn test -B'
                }
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                script {
                    bat 'mvn package -DskipTests -B'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }
    }

    post {
        success {
            echo '✅ Maven build & tests passed!'
        }
        failure {
            echo '❌ Build or tests failed!'
        }
        always {
            cleanWs()
        }
    }
}